{
  "name": "xb",
  "version": "1.27.0",
  "description": "xb enhances your Weibo.com experience",
  "keywords": [
    "browser",
    "chrome",
    "extension",
    "weibo",
    "xb"
  ],
  "homepage": "https://xb-extension.vercel.app/",
  "bugs": {
    "url": "https://github.com/nnecec/xb/issues"
  },
  "license": "GPL-3.0",
  "author": "nnecec <nnecec@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nnecec/xb.git"
  },
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "compile": "tsc --noEmit",
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "knip": "knip",
    "lint": "oxfmt --no-error-on-unmatched-pattern && oxlint --fix --no-error-on-unmatched-pattern",
    "postinstall": "wxt prepare",
    "preinstall": "npx only-allow bun",
    "prepare": "husky",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-visually-hidden": "^1.2.12",
    "@reactuses/core": "^6.5.9",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-core": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@videojs/core": "10.0.1",
    "@videojs/dash-video": "10.0.1",
    "@videojs/hlsjs-video": "10.0.1",
    "@videojs/react": "10.0.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dashjs": "^5.2.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-photo-view": "^1.2.7",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@wxt-dev/module-react": "^1.2.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "knip": "^6.40.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern --write",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.json": "oxfmt --no-error-on-unmatched-pattern --write"
  },
  "allowScripts": {}
}
